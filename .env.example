# ─────────────────────────────────────────────────────────────────────────────
# RivalPR Intel — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection string used by the Go backend (@db resolves to the db container)
DATABASE_URL=postgres://rivalpr:rivalpr_secret@db:5432/rivalpr?sslmode=disable
# ^ this is the internal container-to-container URL (always port 5432 inside Docker network)
# If connecting from the HOST machine (DBeaver, psql, etc.) use port 5433

# Credentials used by the postgres container itself
POSTGRES_USER=rivalpr
POSTGRES_PASSWORD=rivalpr_secret
POSTGRES_DB=rivalpr

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — MUST be at least 32 random characters
JWT_SECRET=change-me-to-a-min-32-char-random-secret-value!!

# bcrypt work factor — higher = slower + more secure (default: 12, min: 10)
BCRYPT_COST=12

# ── AI Integration ────────────────────────────────────────────────────────────
# Anthropic Claude API key — NEVER passed to the frontend container
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Maximum AI pitch generation requests per authenticated user per minute
AI_RATE_LIMIT_RPM=20

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the backend REST API
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
